#!/bin/bash
# 应用中心 start/stop/status。
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "${SELF_DIR}/_common"
case "${1:-}" in
  start)  systemctl start trim-media-online.service 2>>"${TMO_LOG}" || true; exit 0 ;;
  stop)
    systemctl stop trim-media-online.service 2>>"${TMO_LOG}" || true
    sleep 0.5
    # 桌面网关监听的是应用根目录 socket；停止后清理残留，避免应用中心显示连接拒绝。
    for _root in "${TRIM_APPDEST:-}" "${TMO_APP_ROOT}/target" "${TMO_APP_ROOT}"; do
      [ -n "${_root}" ] && rm -f "${_root}/trim-media-online.sock" 2>/dev/null || true
    done
    exit 0
    ;;
  status) systemctl is-active --quiet trim-media-online.service && exit 0 || exit 3 ;;
  *) exit 1 ;;
esac
