#!/bin/bash
# 卸载：停服务、还原官方 socket；默认保留 state 与已转存 STRM。
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "${SELF_DIR}/_common"
[ -n "${TMO_REPO_DIR}" ] && bash "${TMO_REPO_DIR}/deploy/uninstall.sh" >> "${TMO_LOG}" 2>&1 || {
  systemctl stop trim-media-online.service 2>/dev/null || true
  systemctl disable trim-media-online.service 2>/dev/null || true
  rm -f /etc/systemd/system/trim-media-online.service
  systemctl daemon-reload 2>/dev/null || true
}
exit 0
